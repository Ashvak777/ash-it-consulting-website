{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.ashitconsulting.ca" }], "destination": "https://www.ashitconsulting.ai/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "ashitconsulting.ca" }], "destination": "https://www.ashitconsulting.ai/:path*", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/services", "destination": "/solutions", "permanent": true },
    { "source": "/public-sector", "destination": "/sovereignty", "permanent": true }
  ]
}
